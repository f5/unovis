{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "preserve",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": false,
    "paths": {
      "@unovis/ts": ["../ts/src"],
      "@unovis/ts/*": ["../ts/src/*"],
      "@unovis/react": ["../react/src"],
      "@unovis/react/*": ["../react/src/*"],
      "@unovis/svelte": ["../svelte/src"],
      "@unovis/svelte/*": ["../svelte/src/*"],
      "@unovis/solid": ["../solid/src"],
      "@unovis/solid/*": ["../solid/src/*"],
      "@unovis/vue": ["../vue/src"],
      "@unovis/vue/*": ["../vue/src/*"],
      "@unovis/angular": ["../angular/src/public-api"],
      "@unovis/angular/*": ["../angular/src/*"]
    },
  }
}
