{
  "name": "@unovis/react",
  "description": "Modular data visualization framework for React, Angular, Svelte, Vue, Solid, and vanilla TypeScript or JavaScript",
  "version": "1.7.0-csp.1",
  "packageManager": "pnpm@10.23.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/f5/unovis.git",
    "directory": "packages/react"
  },
  "homepage": "https://unovis.dev",
  "bugs": {
    "url": "https://github.com/f5/unovis/issues"
  },
  "keywords": [
    "react",
    "data visualization",
    "maps",
    "charts",
    "graphs"
  ],
  "author": "Nikita Rokotyan, F5 Inc. <nikita@f5.com> (https://rokotyan.com)",
  "maintainers": [
    "Nikita Rokotyan <nikita@f5.com> (https://rokotyan.com)",
    "Qian Liu <qi.liu@f5.com>",
    "Surya Hanumandla <s.hanumandla@f5.com>"
  ],
  "license": "Apache-2.0",
  "main": "./index.js",
  "types": "./index.d.ts",
  "type": "module",
  "sideEffects": [
    "composites/time-series/style.module.css.js",
    "dist/composites/time-series/style.module.css.js"
  ],
  "scripts": {
    "build": "vite build; rm -rf dist/.cache; cp LICENSE README.md package.json ./dist",
    "tsc": "tsc",
    "generate": "tsx ./autogen/index.ts",
    "publish:dist": "cd ./dist; npm publish",
    "license:check": "pnpm license-report --config=../../lic-report-config.json > licences.md"
  },
  "peerDependencies": {
    "@unovis/ts": "1.7.0-csp.1",
    "react": ">=16.8.0 || ^17 || ^18 || ^19",
    "react-dom": ">=16.8.0 || ^17 || ^18 || ^19"
  },
  "devDependencies": {
    "@unovis/ts": "workspace:*",
    "@unovis/shared": "workspace:*",
    "@vitejs/plugin-react": "^4.3.4",
    "@types/react": "^17.0.22",
    "@types/node": "^16.11.17",
    "@types/d3-dispatch": "3.0.6",
    "buffer-from": "^1.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^3.0.2",
    "typescript": "catalog:",
    "tsx": "^4.19.1",
    "vite": "catalog:",
    "vite-plugin-css-injected-by-js": "^3.3.0",
    "vite-plugin-dts": "^3.5.3"
  }
}
