{
  "name": "@unovis/ssr",
  "description": "Server-side rendering for Unovis: render charts to standalone SVG and PNG in Node — no browser, no remote services",
  "version": "1.7.0-mcp.2",
  "packageManager": "pnpm@10.23.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/f5/unovis.git",
    "directory": "packages/ssr"
  },
  "homepage": "https://unovis.dev",
  "bugs": {
    "url": "https://github.com/f5/unovis/issues"
  },
  "keywords": [
    "ssr",
    "server-side rendering",
    "headless",
    "data visualization",
    "charts",
    "svg",
    "png",
    "unovis"
  ],
  "author": "Nikita Rokotyan, F5 Inc. <nikita@f5.com> (https://rokotyan.com)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test --ext .ts",
    "license:check": "pnpm license-report --config=../../lic-report-config.json > licences.md",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "@resvg/resvg-js": "^2.6.2",
    "@unovis/ts": "workspace:*",
    "fflate": "^0.8.3",
    "jsdom": "^26.1.0",
    "svg-path-bounds": "^1.0.2",
    "svg-path-properties": "^1.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.17.0",
    "rimraf": "^3.0.2",
    "typescript": "catalog:",
    "vitest": "^3.0.0"
  }
}
