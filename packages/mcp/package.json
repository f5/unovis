{
  "name": "@unovis/mcp",
  "description": "MCP server that renders Unovis charts to SVG locally in Node — no browser, no remote services",
  "version": "1.7.0-mcp.1",
  "packageManager": "pnpm@10.23.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/f5/unovis.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://unovis.dev",
  "bugs": {
    "url": "https://github.com/f5/unovis/issues"
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "data visualization",
    "charts",
    "svg",
    "llm",
    "unovis"
  ],
  "author": "Nikita Rokotyan, F5 Inc. <nikita@f5.com> (https://rokotyan.com)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "unovis-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./recipes": {
      "types": "./dist/recipes/index.d.ts",
      "default": "./dist/recipes/index.js"
    },
    "./spec": {
      "types": "./dist/render/spec.d.ts",
      "default": "./dist/render/spec.js"
    },
    "./package.json": "./package.json",
    "./chart-spec.schema.json": "./schema/chart-spec.v1.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "schema",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && pnpm build:widget",
    "build:widget": "node scripts/build-widget.mjs",
    "dev": "pnpm build && node dist/cli.js",
    "samples": "pnpm build && node scripts/render-samples.mjs",
    "test": "pnpm --dir ../ssr build && pnpm build:widget && vitest run",
    "test:watch": "pnpm --dir ../ssr build && pnpm build:widget && vitest",
    "lint": "eslint src test scripts --ext .ts",
    "license:check": "pnpm license-report --config=../../lic-report-config.json > licences.md",
    "prepublishOnly": "pnpm build",
    "docs:tools": "node scripts/generate-tool-docs.mjs",
    "dev:tsx": "tsx src/cli.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "docs:schema": "node scripts/generate-spec-schema.mjs",
    "test:images:update": "UPDATE_IMAGES=1 vitest run test/recipes.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@unovis/ssr": "workspace:*",
    "@unovis/ts": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.17.0",
    "@types/pngjs": "^6.0.5",
    "ajv": "^8.20.0",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.3",
    "jsdom": "^26.1.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "rimraf": "^3.0.2",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "^3.0.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
