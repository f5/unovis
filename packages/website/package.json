{
  "name": "@unovis/website",
  "description": "Modular data visualization framework for React, Angular, Svelte, Vue, Solid, and vanilla TypeScript or JavaScript",
  "version": "1.7.1",
  "packageManager": "pnpm@10.23.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/f5/unovis.git",
    "directory": "packages/website"
  },
  "homepage": "https://unovis.dev",
  "bugs": {
    "url": "https://github.com/f5/unovis/issues"
  },
  "keywords": [
    "data visualization",
    "maps",
    "charts",
    "graphs"
  ],
  "author": "Nikita Rokotyan, F5 Inc. <nikita@f5.com> (https://rokotyan.com)",
  "maintainers": [
    "Nikita Rokotyan <nikita@f5.com> (https://rokotyan.com)",
    "Qian Liu <qi.liu@f5.com>",
    "Surya Hanumandla <s.hanumandla@f5.com>"
  ],
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "pnpm sync:mcp-docs && pnpm sync:gallery-prompts && pnpm sync:llms && docusaurus start --port 9300",
    "build": "pnpm sync:mcp-docs && pnpm sync:gallery-prompts && pnpm sync:llms && NODE_OPTIONS=--max-old-space-size=8192 docusaurus build --no-minify",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "license:check": "pnpm license-report --config=../../lic-report-config.json > licences.md",
    "sync:mcp-docs": "node scripts/sync-mcp-docs.mjs",
    "sync:gallery-prompts": "node scripts/sync-gallery-prompts.mjs",
    "sync:llms": "node scripts/sync-llms.mjs"
  },
  "dependencies": {
    "@docsearch/core": "^4.5.0",
    "@docsearch/react": "^4.5.0",
    "@docusaurus/core": "^3.0.1",
    "@docusaurus/plugin-client-redirects": "3.9.2",
    "@docusaurus/plugin-debug": "^3.0.1",
    "@docusaurus/plugin-sitemap": "^3.0.1",
    "@docusaurus/preset-classic": "^3.0.1",
    "@docusaurus/theme-common": "^3.0.1",
    "@docusaurus/theme-mermaid": "^3.0.1",
    "@mdx-js/react": "^3.0.0",
    "@nivo/bar": "0.99.0",
    "@nivo/boxplot": "0.99.0",
    "@nivo/chord": "0.99.0",
    "@nivo/core": "0.99.0",
    "@nivo/geo": "0.99.0",
    "@nivo/heatmap": "0.99.0",
    "@nivo/line": "0.99.0",
    "@nivo/network": "0.99.0",
    "@nivo/pie": "0.99.0",
    "@nivo/polar-bar": "0.99.0",
    "@nivo/radial-bar": "0.99.0",
    "@nivo/sankey": "0.99.0",
    "@nivo/scatterplot": "0.99.0",
    "@nivo/sunburst": "0.99.0",
    "@nivo/treemap": "0.99.0",
    "@observablehq/plot": "0.6.17",
    "@sgratzl/chartjs-chart-boxplot": "4.4.5",
    "@stackblitz/sdk": "1.8.0",
    "@tanstack/charts": "1.1.0",
    "ag-charts-community": "14.2.0",
    "ag-charts-react": "14.2.0",
    "chart.js": "4.5.1",
    "chartjs-chart-geo": "4.3.6",
    "chartjs-chart-graph": "4.3.5",
    "chartjs-chart-matrix": "3.1.0",
    "chartjs-chart-sankey": "0.19.1",
    "chartjs-chart-treemap": "4.2.2",
    "chartjs-plugin-annotation": "3.1.0",
    "chartjs-plugin-datalabels": "2.2.0",
    "clsx": "^1.1.1",
    "d3-force": "3.0.0",
    "d3-geo": "3.1.1",
    "d3-shape": "3.2.0",
    "docusaurus-plugin-react-docgen-typescript": "^0.1.0",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "maplibre-gl": "6.7.0",
    "nodemon": "^3.1.11",
    "prism-react-renderer": "^1.1.0",
    "react-chartjs-2": "5.3.1",
    "react-docgen-typescript": "^2.0.0",
    "react-is": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-vega": "8.0.0",
    "recharts": "3.10.1",
    "topojson-client": "3.1.0",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.5.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.0.0",
    "@docusaurus/tsconfig": "3.0.0",
    "@emotion/css": "^11.7.1",
    "@types/topojson-client": "3.1.5",
    "d3-array": "^3.2.0",
    "d3-scale": "^4.0.0",
    "file-loader": "^6.2.0",
    "raw-loader": "^4.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.2.2"
  },
  "peerDependencies": {
    "@unovis/react": "workspace:*",
    "@unovis/shared": "workspace:*",
    "@unovis/ts": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "trim": "0.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
