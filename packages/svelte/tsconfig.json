{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "include": ["src/**/*"],
  "exclude": ["node_modules/*"],
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es6",
    "experimentalDecorators": true,
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "preserveValueImports": false,
    "ignoreDeprecations": "5.0"
  }
}
