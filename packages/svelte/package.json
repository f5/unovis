{
  "name": "@unovis/svelte",
  "description": "Modular data visualization framework for React, Angular, Svelte, Vue, Solid, and vanilla TypeScript or JavaScript",
  "version": "1.6.7",
  "packageManager": "pnpm@10.23.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/f5/unovis.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://unovis.dev",
  "bugs": {
    "url": "https://github.com/f5/unovis/issues"
  },
  "keywords": [
    "svelte",
    "data visualization",
    "maps",
    "charts",
    "graphs"
  ],
  "author": "Rebecca Bol, F5 Inc. <r.bol@f5.com>",
  "maintainers": [
    "Nikita Rokotyan <nikita@f5.com> (https://rokotyan.com)",
    "Qian Liu <qi.liu@f5.com>",
    "Surya Hanumandla <s.hanumandla@f5.com>"
  ],
  "license": "Apache-2.0",
  "main": "./index.js",
  "types": "./index.d.ts",
  "svelte": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "svelte": "./index.js"
    }
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run check && pnpm svelte-package --input src; rm -rf dist/.cache; cp LICENSE README.md package.json ./dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "generate": "tsx ./autogen/index.ts",
    "gallery": "vite",
    "publish:dist": "cd ./dist; npm publish",
    "license:check": "pnpm license-report --config=../../lic-report-config.json > licences.md"
  },
  "peerDependencies": {
    "@unovis/ts": "1.6.7",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@unovis/ts": "workspace:*",
    "@unovis/shared": "workspace:*",
    "@sveltejs/package": "~2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "~5.0.8",
    "eslint-plugin-svelte": "^2.10.0",
    "svelte": "~5.56.9",
    "svelte-check": "~4.7.6",
    "tslib": "^2.3.1",
    "tsx": "^4.19.1",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {}
}
