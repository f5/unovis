{
  // "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*.vue", "src/**/*.ts"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "resolveJsonModule": true
  },
  "exclude": ["node_modules/*"]
}
